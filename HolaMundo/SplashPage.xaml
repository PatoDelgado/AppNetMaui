<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HolaMundo.SplashPage"
             BackgroundColor="Black">

    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="20">

        <Image
            Source="splash.svg"
            WidthRequest="220"
            HeightRequest="150"
            Aspect="AspectFit" />

        <Label
            Text="F1 MANAGER"
            TextColor="White"
            FontSize="32"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="Race • Strategy • Championship"
            TextColor="LightGray"
            FontSize="16"
            HorizontalOptions="Center" />

        <ActivityIndicator
            IsRunning="True"
            Color="White"
            WidthRequest="40"
            HeightRequest="40" />

    </VerticalStackLayout>

</ContentPage>