<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HolaMundo.Models"
             xmlns:vm="clr-namespace:HolaMundo.ViewModels"
             x:DataType="vm:JornadaViewModel"
             x:Class="HolaMundo.Views.JornadaPage"
             Title="Mi Jornada">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,*"
          RowSpacing="12" ColumnSpacing="10">

        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
            <Label Text="{Binding Saludo}" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="FechaLabel" Style="{StaticResource TextoSecundario}" />
            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                <Button Text="{Binding TextoBotonTurno}"
                        Command="{Binding AlternarTurnoCommand}"
                        Padding="10,4"
                        FontSize="12" />
                <Button Text="Cerrar sesión"
                        Command="{Binding CerrarSesionCommand}"
                        Padding="10,4"
                        FontSize="12"
                        BackgroundColor="#78909C" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4" HorizontalOptions="End">
            <Button Text="Actualizar"
                    Command="{Binding RefrescaParadasCommand}"
                    Padding="12,5"
                    FontSize="13"
                    HorizontalOptions="End" />
            <ActivityIndicator IsRunning="{Binding IsRefrescando}"
                               IsVisible="{Binding IsRefrescando}"
                               HorizontalOptions="End"
                               WidthRequest="22"
                               HeightRequest="22" />
            <Label Text="{Binding MensajeEstado}"
                   Style="{StaticResource TextoSecundario}"
                   FontSize="11"
                   HorizontalOptions="End" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BorderPrincipal}">
            <VerticalStackLayout Spacing="3">
                <Label Text="Entregas de hoy" Style="{StaticResource TextoSecundario}" />
                <Label Text="{Binding TotalEntregas}" FontSize="26" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BorderPrincipal}">
            <VerticalStackLayout Spacing="3">
                <Label Text="Completadas / Período" Style="{StaticResource TextoSecundario}" />
                <HorizontalStackLayout Spacing="6">
                    <Label Text="{Binding EntregasCompletadas}" FontSize="26" FontAttributes="Bold" TextColor="#2E7D32" />
                    <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                        <Label Text="{Binding EntregasEstaSemana, StringFormat='Sem: {0}'}"
                               FontSize="11"
                               TextColor="Gray" />
                        <Label Text="{Binding EntregasEsteMes, StringFormat='Mes: {0}'}"
                               FontSize="11"
                               TextColor="Gray" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- O2: Filtro por estado (Reto O2) y Switches -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Padding="10,6"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#1E293B}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto" RowSpacing="6" ColumnSpacing="8" VerticalOptions="Center">
                
                <!-- O2: Selector de Filtro de Estado -->
                <Label Grid.Row="0" Grid.Column="0" Text="Filtrar (O2):" VerticalOptions="Center" FontAttributes="Bold" FontSize="12" />
                <Picker Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding OpcionesFiltro}"
                        SelectedItem="{Binding FiltroSeleccionado}"
                        FontSize="12"
                        HeightRequest="36"
                        VerticalOptions="Center" />

                <Label Grid.Row="0" Grid.Column="2"
                       Text="Más cercanas (GPS)"
                       VerticalOptions="Center"
                       FontSize="11" />
                <Switch Grid.Row="0" Grid.Column="3"
                        IsToggled="{Binding OrdenarPorCercania}"
                        VerticalOptions="Center" />

                <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="4" Spacing="10" VerticalOptions="Center">
                    <Label Text="Ocultar entregadas:"
                           VerticalOptions="Center"
                           FontSize="12"
                           FontAttributes="Bold" />
                    <Switch IsToggled="{Binding OcultarEntregadas}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <CollectionView Grid.Row="3" Grid.ColumnSpan="2"
                        ItemsSource="{Binding Paradas}"
                        SelectedItem="{Binding ParadaSeleccionada}"
                        SelectionMode="Single">

            <CollectionView.EmptyView>
                <Label Text="No hay paradas para mostrar con el filtro actual"
                       FontSize="15"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Parada">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnParadaTapped" />
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0" BackgroundColor="#1C7293"
                                    WidthRequest="34" HeightRequest="34" StrokeShape="RoundRectangle 17">
                                <Label Text="{Binding Numero}" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Cliente}" Style="{StaticResource ClienteLabel}" />
                                <Label Text="{Binding Direccion}" Style="{StaticResource TextoListas}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding DistanciaTexto, StringFormat='📍 {0}'}" FontSize="11" TextColor="#0288D1" FontAttributes="Bold" />
                                    <!-- N11: Badge en lista de intentos fallidos si tiene alguno -->
                                    <Label Text="{Binding IntentosFallidos, StringFormat='⚠️ {0} fallo(s)'}"
                                           TextColor="#E65100"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           IsVisible="{Binding IntentosFallidos}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="{Binding Estado, Converter={StaticResource EstadoADisplay}}"
                                   TextColor="{Binding Estado, Converter={StaticResource EstadoAColor}}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
