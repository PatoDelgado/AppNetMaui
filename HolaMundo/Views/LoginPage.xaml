<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HolaMundo.Models"
             xmlns:vm="clr-namespace:HolaMundo.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="HolaMundo.Views.LoginPage"
             Title="Iniciar Sesión">

    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">
        <Label Text="Bienvenido a Última Milla"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Selecciona tu perfil de repartidor para continuar:"
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Repartidores}"
                        SelectionMode="Single"
                        SelectionChanged="OnRepartidorSeleccionado">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Repartidor">
                    <Border Padding="14" Margin="0,6"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                        <Label Text="{Binding Nombre}"
                               Padding="6"
                               FontSize="18"
                               FontAttributes="Bold" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>

</ContentPage>
