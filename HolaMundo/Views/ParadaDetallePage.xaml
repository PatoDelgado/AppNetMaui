<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HolaMundo.ViewModels"
             x:DataType="vm:ParadaDetalleViewModel"
             x:Class="HolaMundo.Views.ParadaDetallePage"
             Title="Detalle de la parada">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{Binding Parada.Cliente}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Parada.Direccion}" Style="{StaticResource TextoSecundario}" />

            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="Estado actual:" FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
                <Label Text="{Binding Parada.Estado, Converter={StaticResource EstadoADisplay}}"
                       TextColor="{Binding Parada.Estado, Converter={StaticResource EstadoAColor}}"
                       FontAttributes="Bold" FontSize="15" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- N11: Mostrar Intentos Fallidos acumulados -->
            <Border IsVisible="{Binding TieneIntentosFallidos}"
                    BackgroundColor="#FFF8E1"
                    Stroke="#FFA000"
                    Padding="10"
                    StrokeShape="RoundRectangle 8">
                <Label Text="{Binding Parada.IntentosFallidos, StringFormat='⚠️ Esta parada lleva {0} intento(s) fallido(s)'}"
                       TextColor="#FF6F00"
                       FontAttributes="Bold"
                       FontSize="12"
                       HorizontalOptions="Center" />
            </Border>

            <Border IsVisible="{Binding EsEntregada}"
                    BackgroundColor="#E8F5E9"
                    Stroke="#2E7D32"
                    Padding="14"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="✓ Parada Entregada"
                           TextColor="#2E7D32"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <!-- N9: Mostrar quién recibió -->
                    <Label Text="{Binding Parada.QuienRecibio, StringFormat='Recibió: {0}'}"
                           TextColor="#1B5E20"
                           FontAttributes="Bold"
                           FontSize="13" />
                    <Label Text="Esta parada ya fue entregada con éxito. El registro está cerrado y no se puede modificar."
                           TextColor="#2E7D32"
                           FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding EsFallida}"
                    BackgroundColor="#FFEBEE"
                    Stroke="#C62828"
                    Padding="14"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="⚠ Entrega Fallida"
                           TextColor="#C62828"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="{Binding Parada.RazonFallo, StringFormat='Razón: {0}'}"
                           TextColor="#B71C1C"
                           FontSize="13" />
                    <Label Text="{Binding TiempoEnFallo}"
                           TextColor="#D32F2F"
                           FontSize="11"
                           FontAttributes="Italic" />
                </VerticalStackLayout>
            </Border>

            <Button Text="🔄 Reintentar entrega"
                    Command="{Binding ReintentarCommand}"
                    BackgroundColor="DarkGoldenrod"
                    TextColor="White"
                    FontAttributes="Bold"
                    IsVisible="{Binding EsFallida}" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />

            <VerticalStackLayout IsVisible="{Binding EsEditable}" Spacing="14">
                <Label Text="Marcar resultado de entrega:" FontAttributes="Bold" FontSize="16" />

                <!-- N9: Campo para registrar quién recibe el paquete -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Persona que recibe el paquete (opcional, por defecto es el cliente):"
                           FontSize="12"
                           TextColor="Gray" />
                    <Entry Placeholder="Nombre de quien recibe..."
                           Text="{Binding QuienRecibio}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Razón de fallo (obligatoria para marcar como fallida):"
                           FontSize="12"
                           TextColor="Gray" />
                    <Entry Placeholder="Ej: Cliente ausente, dirección incorrecta..."
                           Text="{Binding RazonFallo}" />
                </VerticalStackLayout>

                <Label Text="{Binding MensajeEstado}" TextColor="IndianRed" FontSize="13" />

                <ActivityIndicator IsRunning="{Binding IsGuardando}"
                                   IsVisible="{Binding IsGuardando}"
                                   Color="#1C7293"
                                   WidthRequest="32"
                                   HeightRequest="32"
                                   HorizontalOptions="Center" />

                <Button Text="Marcar entregada"
                        Command="{Binding MarcarEntregadaCommand}"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        FontAttributes="Bold" />

                <!-- N3: Botón con confirmación -->
                <Button Text="Marcar fallida (Pide confirmación)"
                        Command="{Binding MarcarFallidaCommand}"
                        BackgroundColor="#C62828"
                        TextColor="White"
                        FontAttributes="Bold" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
