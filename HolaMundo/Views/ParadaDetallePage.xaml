<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HolaMundo.ViewModels"
             x:DataType="vm:ParadaDetalleViewModel"
             x:Class="HolaMundo.Views.ParadaDetallePage"
             Title="Detalle de la parada">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Información del cliente y dirección -->
            <Label Text="{Binding Parada.Cliente}" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Parada.Direccion}" Style="{StaticResource TextoSecundario}" />

            <!-- Estado actual -->
            <HorizontalStackLayout Spacing="8">
                <Label Text="Estado actual:" FontAttributes="Bold" />
                <Label Text="{Binding Parada.Estado}" FontAttributes="Bold" />
            </HorizontalStackLayout>

            <!-- Banner informativo si ya fue entregada (Reto 4: No editable) -->
            <Border IsVisible="{Binding EsEntregada}"
                    BackgroundColor="#E8F5E9"
                    Stroke="#2E7D32"
                    Padding="14"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="✓ Parada Entregada"
                           TextColor="#2E7D32"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="Esta parada ya fue entregada con éxito. El registro está cerrado y no se puede modificar."
                           TextColor="#1B5E20"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Banner informativo si la parada falló -->
            <Border IsVisible="{Binding EsFallida}"
                    BackgroundColor="#FFEBEE"
                    Stroke="#C62828"
                    Padding="14"
                    StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="4">
                    <Label Text="⚠ Entrega Fallida"
                           TextColor="#C62828"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="{Binding Parada.RazonFallo, StringFormat='Razón registrada: {0}'}"
                           TextColor="#B71C1C"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- Botón Reintentar (Reto 2: de Fallida a Pendiente) -->
            <Button Text="🔄 Reintentar entrega (Regresar a Pendiente)"
                    Command="{Binding ReintentarEntregaCommand}"
                    BackgroundColor="#FF8811"
                    TextColor="White"
                    FontAttributes="Bold"
                    IsVisible="{Binding EsFallida}" />

            <BoxView HeightRequest="1" BackgroundColor="LightGray" Margin="0,8" />

            <!-- Sección de Acciones (Oculta y deshabilitada si ya fue entregada) -->
            <VerticalStackLayout IsVisible="{Binding EsEditable}" Spacing="14">
                <Label Text="Marcar resultado de entrega:" FontAttributes="Bold" FontSize="16" />

                <!-- Razón de fallo requerida para habilitar Marcar Fallida (Reto 1) -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Razón de fallo (obligatoria para marcar como fallida):"
                           FontSize="12"
                           TextColor="Gray" />
                    <Entry Placeholder="Ej: Cliente ausente, dirección incorrecta..."
                           Text="{Binding RazonFallo}" />
                </VerticalStackLayout>

                <Label Text="{Binding MensajeEstado}" TextColor="IndianRed" FontSize="13" />

                <!-- Reto 3: Spinner mientras guarda -->
                <ActivityIndicator IsRunning="{Binding IsGuardando}"
                                   IsVisible="{Binding IsGuardando}"
                                   Color="#1C7293"
                                   WidthRequest="32"
                                   HeightRequest="32"
                                   HorizontalOptions="Center" />

                <!-- Botones principales -->
                <Button Text="Marcar entregada"
                        Command="{Binding MarcarEntregadaCommand}"
                        BackgroundColor="#2E7D32"
                        TextColor="White"
                        FontAttributes="Bold" />

                <Button Text="Marcar fallida"
                        Command="{Binding MarcarFallidaCommand}"
                        BackgroundColor="#C62828"
                        TextColor="White"
                        FontAttributes="Bold" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
