<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HolaMundo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HolaMundo.Views"
    xmlns:local="clr-namespace:HolaMundo"
    Title="Última Milla"
    FlyoutBehavior="Disabled">

    <!-- El login queda fuera del TabBar: no muestra pestañas -->
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Cada ShellContent dentro del TabBar es una pestaña -->
    <TabBar>
        <ShellContent
            Title="Jornada"
            Route="JornadaPage"
            ContentTemplate="{DataTemplate views:JornadaPage}" />

        <ShellContent
            Title="Histórico"
            Route="HistoricoPage"
            ContentTemplate="{DataTemplate views:HistoricoPage}" />
    </TabBar>

    <!-- Conservamos MainPage original -->
    <ShellContent
        Title="Inicio Original"
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

</Shell>
