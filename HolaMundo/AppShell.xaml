<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HolaMundo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HolaMundo.Views"
    xmlns:local="clr-namespace:HolaMundo"
    Title="Última Milla">

    <!-- LoginPage primero: es la pantalla con la que arranca la app -->
    <ShellContent
        Title="Login"
        Route="LoginPage"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- JornadaPage registrada con Route="JornadaPage" -->
    <ShellContent
        Title="Mi Jornada"
        Route="JornadaPage"
        ContentTemplate="{DataTemplate views:JornadaPage}" />

    <!-- Conservamos MainPage original -->
    <ShellContent
        Title="Inicio Original"
        Route="MainPage"
        ContentTemplate="{DataTemplate local:MainPage}" />

</Shell>
